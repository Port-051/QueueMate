# redis-ha-lab 환경 변수. 이 파일을 .env 로 복사해서 쓴다.
#
#   cp .env.example .env
#   ./scripts/host-ip.sh >> .env      # HOST_IP 를 자동으로 채운다
#
# HOST_IP 는 WSL2 의 eth0 주소다. 재부팅하면 바뀌므로 그때마다 다시 채워야 한다.
# 왜 이 값이 필요한지는 README.md "토폴로지를 왜 이렇게 잡았나" 를 보라.
HOST_IP=127.0.0.1

# 기존 프로젝트가 쓰는 이미지와 같은 것으로 맞춘다 (START_HERE.md:100 - redis:7-alpine).
# 실험 결과를 재현하려면 태그를 고정하는 편이 낫다: redis:7.2-alpine
REDIS_IMAGE=redis:7-alpine

# Sentinel 튜닝 값. 실험 3 이 이 세 개를 바꿔 가며 돌린다.
QUORUM=2
DOWN_AFTER=5000
FAILOVER_TIMEOUT=60000
PARALLEL_SYNCS=1

# 실험 4 (비동기 복제로 인한 락 유실) 에서 켠다. 0 이면 끈 것이다.
MIN_REPLICAS_TO_WRITE=0
MIN_REPLICAS_MAX_LAG=10
