DB_URL=jdbc:postgresql://localhost:5432/queuemate
DB_USER=queuemate
DB_PASSWORD=queuemate
REDIS_HOST=localhost
REDIS_PORT=6379
PROPOSAL_TTL_SECONDS=20
# 32 bytes 이상. 운영에서는 반드시 교체한다.
JWT_SECRET=local-development-only-secret-key-change-me-32b
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# 소셜 로그인. 실제 값은 .env에만 둔다 (저장소에 넣지 않는다).
# Redirect URI는 제공자 콘솔에 글자 단위로 같게 등록해야 한다.
#   카카오: http://localhost:8080/api/v1/auth/oauth/kakao/callback
#   네이버: http://localhost:8080/api/v1/auth/oauth/naver/callback
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 이메일 동의항목이 막히면 KAKAO_SCOPE=profile_nickname 으로 줄인다.
KAKAO_SCOPE=profile_nickname,account_email
