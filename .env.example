# Tailscale 등 원격 미리보기에서 사용할 정확한 호스트 이름. 스킴과 포트는 제외한다.
# .env.local에 설정하며, 비워두면 로컬 개발만 허용한다.
QUEUEMATE_PREVIEW_HOST=
# 매칭 서버를 다른 포트로 실행한 경우 .env.local에서 지정한다. 기본값: http://localhost:8080
QUEUEMATE_MATCHING_URL=
# Google Analytics 4 측정 ID(G-…). 운영 빌드의 .env.production 에 둔다. 비워 두면 분석 스크립트를 싣지 않고 이벤트도 보내지 않는다(src/analytics/ga.ts).
VITE_GA_MEASUREMENT_ID=
