{
  "name": "queuemate-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "VITE_API_MODE=real vite --port 5173 --strictPort",
    "dev:mock": "VITE_API_MODE=mock vite --port 5174 --strictPort",
    "dev:mock-server": "sh -c 'node ../mock-server/server.js & MOCK_PID=$!; trap \"kill $MOCK_PID 2>/dev/null\" EXIT INT TERM; VITE_API_MODE=real vite --port 5173 --strictPort'",
    "mock-server": "node ../mock-server/server.js",
    "mock-server:smoke": "bash ../mock-server/contract-smoke.sh",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "e2e": "playwright test"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
